# Database
DATABASE_URL="postgresql://user:password@localhost:5432/clinicplus_db"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"
AUTH_TRUST_HOST=true

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ClinicPlus HMS"

# Email
EMAIL_SERVER="smtp://your-email:your-password@smtp.gmail.com:587"
EMAIL_FROM="noreply@clinicplus.local"

# File Storage (Cloudinary or S3)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-key"
CLOUDINARY_API_SECRET="your-cloudinary-secret"

# SMS Provider (Optional)
SMS_API_KEY="your-sms-api-key"
SMS_PROVIDER="africastalking" # or twilio, vonage, etc

# Payment Provider (Abstract - configure in settings)
PAYMENT_PROVIDER="mobile_money" # or stripe, paypal, etc
PAYMENT_API_KEY="your-payment-key"

# Currency
NEXT_PUBLIC_CURRENCY="UGX"
NEXT_PUBLIC_CURRENCY_SYMBOL="UGX"

# Feature Flags
NEXT_PUBLIC_ENABLE_2FA=false
NEXT_PUBLIC_DEMO_MODE=true
