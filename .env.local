# Local development environment - DO NOT COMMIT
# Copy from .env.example and configure for local development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicplus_db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-key-minimum-32-characters-long"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email - for development (using Resend or Mailtrap)
EMAIL_SERVER="smtp://test@example.com:password@smtp.mailtrap.io:465"
EMAIL_FROM="dev@clinicplus.local"

# Storage - Use Cloudinary for development
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dev-cloud"
CLOUDINARY_API_KEY="dev-key"
CLOUDINARY_API_SECRET="dev-secret"

# Payment - Development mode
PAYMENT_PROVIDER="test_mode"

# Enable demo mode for seed data
NEXT_PUBLIC_DEMO_MODE=true
