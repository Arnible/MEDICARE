// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Organization & Tenant Management
// ============================================

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  logo          String?
  website       String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  timezone      String   @default("Africa/Kampala")
  currency      String   @default("UGX")
  registrationNumber String?
  
  // Multi-tenancy
  branches      Branch[]
  users         User[]
  departments   Department[]
  patients      Patient[]
  staff         Staff[]
  appointments  Appointment[]
  encounters    Encounter[]
  medicines     Medicine[]
  suppliers     Supplier[]
  inventoryItems InventoryItem[]
  invoices      Invoice[]
  labTests      LabTest[]
  insuranceProviders InsuranceProvider[]
  settings      SystemSetting[]
  auditLogs     AuditLog[]
  prescriptions Prescription[]
  labRequests   LabRequest[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Branch {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name          String
  code          String   @unique
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  isActive      Boolean  @default(true)
  
  patients      Patient[]
  staff         Staff[]
  appointments  Appointment[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Authentication & Authorization
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  phone         String?
  avatar        String?
  
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  branches      Branch[] // Users can access multiple branches
  
  role          Role     @relation(fields: [roleId], references: [id])
  roleId        String
  
  isActive      Boolean  @default(true)
  emailVerified DateTime?
  lastLogin     DateTime?
  loginAttempts Int      @default(0)
  lockedUntil   DateTime?
  
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  
  staff         Staff?
  auditLogs     AuditLog[]
  sessions      Session[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  
  permissions RolePermission[]
  users       User[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  module      String
  action      String
  
  roles       RolePermission[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RolePermission {
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId        String
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId  String
  
  @@id([roleId, permissionId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  expires       DateTime
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime @default(now())
}

// ============================================
// Departments
// ============================================

model Department {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name          String
  code          String
  description   String?
  isActive      Boolean  @default(true)
  
  staff         Staff[]
  appointments  Appointment[]
  encounters    Encounter[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([organizationId, code])
}

// ============================================
// Patient Management
// ============================================

model Patient {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  branch        Branch   @relation(fields: [branchId], references: [id])
  branchId      String
  
  patientNumber String   @unique
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime
  gender        String
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  
  bloodGroup    String?
  allergies     String?
  
  nationalId    String?
  idType        String?
  
  insuranceNumber   String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  
  status        String   @default("ACTIVE")
  registrationDate DateTime @default(now())
  
  consultations Encounter[]
  appointments  Appointment[]
  prescriptions Prescription[]
  labRequests   LabRequest[]
  invoices      Invoice[]
  documents     Document[]
  vitals        Vital[]
  insurancePolicies InsurancePolicy[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

// ============================================
// Staff Management
// ============================================

model Staff {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  branch        Branch?  @relation(fields: [branchId], references: [id])
  branchId      String?
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId        String   @unique
  
  employeeId    String   @unique
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  String
  jobTitle      String
  specialization String?
  licenseNumber String?
  licenseExpiry DateTime?
  
  status        String   @default("ACTIVE")
  joiningDate   DateTime
  
  appointments  Appointment[]
  encounters    Encounter[]
  prescriptions Prescription[]
  labRequests   LabRequest[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Appointments
// ============================================

model Appointment {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  branch        Branch   @relation(fields: [branchId], references: [id])
  branchId      String
  
  appointmentNumber String @unique
  
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  doctor        Staff    @relation(fields: [doctorId], references: [id])
  doctorId      String
  
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  String
  
  appointmentDate DateTime
  startTime     DateTime
  endTime       DateTime?
  
  type          String
  reason        String?
  notes         String?
  
  status        String   @default("PENDING")
  checkinTime   DateTime?
  completedAt   DateTime?
  
  queueNumber   Int?
  
  encounter     Encounter?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

// ============================================
// Clinical / EMR
// ============================================

model Encounter {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  doctor        Staff    @relation(fields: [doctorId], references: [id])
  doctorId      String
  
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  String
  
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId String? @unique
  
  chiefComplaint String
  historyOfPresentIllness String?
  pastMedicalHistory String?
  familyHistory String?
  socialHistory String?
  
  physicalExamination String?
  
  assessment    String
  
  primaryDiagnosis String?
  secondaryDiagnosis String?
  
  treatmentPlan String?
  followUpDate  DateTime?
  
  clinicalNotes String
  doctorSignature String?
  
  vitals        Vital[]
  prescriptions Prescription[]
  labRequests   LabRequest[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Vital {
  id            String   @id @default(cuid())
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  encounter     Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  encounterId   String?
  
  temperature   Float?
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  pulse         Int?
  respiratoryRate Int?
  oxygenSaturation Int?
  weight        Float?
  height        Float?
  bmi           Float?
  painScore     Int?
  
  recordedAt    DateTime
  recordedBy    String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Prescriptions & Pharmacy
// ============================================

model Prescription {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  prescriptionNumber String @unique
  
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  encounterId   String
  
  doctor        Staff    @relation(fields: [doctorId], references: [id])
  doctorId      String
  
  items         PrescriptionItem[]
  
  status        String   @default("DRAFT")
  issuedAt      DateTime @default(now())
  dispensedAt   DateTime?
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model PrescriptionItem {
  id            String   @id @default(cuid())
  prescription  Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescriptionId String
  
  medicine      Medicine @relation(fields: [medicineId], references: [id])
  medicineId    String
  
  dosage        String
  frequency     String
  route         String
  duration      String
  quantity      Int
  instructions  String?
  
  dispensedQuantity Int @default(0)
  transactions  PharmacyTransaction[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Medicine {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  name          String
  genericName   String?
  brandName     String?
  
  category      String
  unit          String
  strength      String
  
  purchasePrice Float
  sellingPrice  Float
  
  reorderLevel  Int      @default(10)
  batches       MedicineBatch[]
  
  isActive      Boolean  @default(true)
  
  prescriptionItems PrescriptionItem[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MedicineBatch {
  id            String   @id @default(cuid())
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  medicineId    String
  
  batchNumber   String
  expiryDate    DateTime
  
  quantity      Int
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  supplierId    String
  
  purchaseDate  DateTime
  purchasePrice Float
  
  isExpired     Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([medicineId, batchNumber])
}

model PharmacyTransaction {
  id            String   @id @default(cuid())
  
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  prescriptionItemId String
  
  quantity      Int
  dispensedDate DateTime @default(now())
  pharmacist    String?
  
  createdAt     DateTime @default(now())
}

// ============================================
// Inventory Management
// ============================================

model Supplier {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  
  isActive      Boolean  @default(true)
  
  medicineBatches MedicineBatch[]
  purchaseOrders PurchaseOrder[]
  inventoryItems InventoryItem[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InventoryItem {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  sku           String   @unique
  name          String
  description   String?
  
  category      String
  unit          String
  
  quantity      Int      @default(0)
  reorderLevel  Int      @default(10)
  
  purchasePrice Float
  sellingPrice  Float
  
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  supplierId    String
  
  expiryDate    DateTime?
  batchNumber   String?
  
  isActive      Boolean  @default(true)
  
  stockMovements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StockMovement {
  id            String   @id @default(cuid())
  
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId        String
  
  type          String
  quantity      Int
  reference     String?
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  
  purchaseOrderNumber String @unique
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  supplierId    String
  
  items         PurchaseOrderItem[]
  
  orderDate     DateTime
  expectedDeliveryDate DateTime?
  receivedDate  DateTime?
  
  status        String   @default("PENDING")
  totalAmount   Float
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseOrderItem {
  id            String   @id @default(cuid())
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  
  item          InventoryItem @relation(fields: [itemId], references: [id])
  itemId        String
  
  quantity      Int
  unitPrice     Float
  totalPrice    Float
  
  createdAt     DateTime @default(now())
}

// ============================================
// Laboratory
// ============================================

model LabTest {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  code          String   @unique
  name          String
  description   String?
  
  category      String
  unit          String?
  referenceRangeMin Float?
  referenceRangeMax Float?
  
  isActive      Boolean  @default(true)
  
  requests      LabRequestTest[]
  results       LabResult[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LabRequest {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  requestNumber String   @unique
  
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  encounterId   String
  
  requestedBy   Staff    @relation(fields: [requestedById], references: [id])
  requestedById String
  
  tests         LabRequestTest[]
  
  status        String   @default("PENDING")
  
  sampleCollectionDate DateTime?
  collectedBy   String?
  
  completedAt   DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LabRequestTest {
  id            String   @id @default(cuid())
  labRequest    LabRequest @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  labRequestId  String
  
  test          LabTest  @relation(fields: [testId], references: [id])
  testId        String
  
  result        LabResult?
  
  @@unique([labRequestId, testId])
}

model LabResult {
  id            String   @id @default(cuid())
  test          LabTest  @relation(fields: [testId], references: [id])
  testId        String
  
  labRequestTest LabRequestTest? @relation(fields: [labRequestTestId], references: [id])
  labRequestTestId String? @unique
  
  value         String
  unit          String?
  referenceRange String?
  flag          String?
  
  enteredBy     String?
  enteredAt     DateTime
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Billing & Payments
// ============================================

model Invoice {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  invoiceNumber String   @unique
  
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  items         InvoiceItem[]
  payments      Payment[]
  refunds       Refund[]
  
  subtotal      Float
  tax           Float    @default(0)
  discount      Float    @default(0)
  total         Float
  
  paidAmount    Float    @default(0)
  balanceAmount Float
  
  status        String   @default("PENDING")
  
  dueDate       DateTime?
  issuedDate    DateTime @default(now())
  paidDate      DateTime?
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  
  description   String
  quantity      Int      @default(1)
  unitPrice     Float
  total         Float
  
  service       String?
  
  createdAt     DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  
  amount        Float
  paymentMethod String
  paymentReference String?
  
  status        String   @default("COMPLETED")
  paymentDate   DateTime @default(now())
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Refund {
  id            String   @id @default(cuid())
  
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  
  amount        Float
  reason        String
  
  processedBy   String?
  processedAt   DateTime @default(now())
  
  status        String   @default("PENDING")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Insurance
// ============================================

model InsuranceProvider {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  name          String
  code          String   @unique
  email         String?
  phone         String?
  
  isActive      Boolean  @default(true)
  
  policies      InsurancePolicy[]
  claims        InsuranceClaim[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InsurancePolicy {
  id            String   @id @default(cuid())
  
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  provider      InsuranceProvider @relation(fields: [providerId], references: [id])
  providerId    String
  
  policyNumber  String
  membershipNumber String?
  
  coveragePercentage Int
  
  validFrom     DateTime
  validTo       DateTime?
  
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InsuranceClaim {
  id            String   @id @default(cuid())
  
  provider      InsuranceProvider @relation(fields: [providerId], references: [id])
  providerId    String
  
  claimNumber   String   @unique
  
  claimedAmount Float
  approvedAmount Float?
  
  status        String   @default("PENDING")
  
  submittedDate DateTime @default(now())
  processedDate DateTime?
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Documents
// ============================================

model Document {
  id            String   @id @default(cuid())
  
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  
  type          String
  
  url           String
  fileName      String
  mimeType      String
  fileSize      Int
  
  uploadedBy    String?
  uploadedAt    DateTime @default(now())
  
  notes         String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Notifications
// ============================================

model Notification {
  id            String   @id @default(cuid())
  
  userId        String
  type          String
  title         String
  message       String
  
  relatedEntity String?
  relatedId     String?
  
  isRead        Boolean  @default(false)
  readAt        DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// Audit Logging
// ============================================

model AuditLog {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  
  action        String
  module        String
  
  entityType    String
  entityId      String
  
  changes       String?
  
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime @default(now())
}

// ============================================
// System Settings
// ============================================

model SystemSetting {
  id            String   @id @default(cuid())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  
  key           String
  value         String
  description   String?
  
  isEditable    Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([organizationId, key])
}
